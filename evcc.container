[Unit]
Description=evcc Container
Wants=plcnext.service
After=plcnext.service

# See this file for explanation
# https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Container]
ContainerName=evcc-for-plcnext-${APP_ID}
Image=${IMAGE_NAME}:${IMAGE_TAG}
Volume=${APP_PERSISTENT_DIR}/data/.evcc:/root/.evcc
# app_user (1001) and plcnext group (1002), see
# https://github.com/PLCnext/CatanIO/tree/main/apps#permissions
User=1001:1002
GroupAdd=keep-groups
UserNS=keep-id
PublishPort=${FIRST_OUTGRESS_PORT}:${FIRST_INGRESS_PORT}
# Use the host's timezone
Timezone=local

[Service]
Restart=always

[Install]
WantedBy=default.target
